# Copy to `.env` and fill in real values. `.env` is gitignored.

# --- Required ---
# JWT signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Resend API key for the daily summary + Sunday reminder emails.
RESEND_API_KEY=re_change_me

# --- Environment ---
# PROD (default) or DEV. DEV seeds a test admin user and 3 weeks of timetable rows.
ENVIRONMENT=DEV

# DEV only: startup raises KeyError if either of these is missing.
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=change-me-at-least-8-chars

# --- Optional ---
# SQLite file path. Docker Compose sets /app/data/database.db.
DB_PATH=data/database.db

# Set to true to skip creating the shared guest user.
DISABLE_GUEST_MODE=false
