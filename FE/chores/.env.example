# Copy to `.env.development` (local) or `.env.production` (deployed build).
# VITE_* vars are inlined at build time — rebuild after changing them.

# Base URL the SPA calls. Locally the backend root_path is stripped, so no /api suffix.
VITE_API_BASE=https://local.app.com:8000

# Set to "true" to hide the Guest Mode button on /login.
VITE_DISABLE_GUEST=false
