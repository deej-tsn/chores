# Copy to `.deploy.env` (gitignored) and fill in. Read by scripts/release.sh.
# Everything here is a path or a host alias — never put secrets in this file.
# The values below are the real production ones as of the last audit, so this file is mostly a
# record of the topology; adjust if the host moves.

# ssh alias for the VPS (`ssh do` must work; the key is passphrase-protected, so it prompts).
HOST=do

# --- Required ---
# nginx on the host serves the built frontend from here (see the chores vhost).
WEB_ROOT=/home/util/chores/dist
# Directory on the host holding the production compose file (deploy/docker-compose.vps.yml).
COMPOSE_DIR=/root/docker-compose-scripts
# Live SQLite file, bind-mounted to /app/data in the container. Backed up before every release.
REMOTE_DB=/home/util/chores/data/database.db

# --- Optional ---
# Docker Hub repository — no tag here, it must not contain a colon.
# IMAGE_REPO=deejtsn/private
# The tag releases are named after. An immutable tag is pushed as `<TAG_BASE>-<git-sha>`.
# TAG_BASE=chores_api_v1
# Compose service name in the production compose file (NOT `api`, which is the dev one).
# SERVICE=chores_api
# Target platform. The dev machine is arm64 and the VPS is amd64 — do not change casually.
# PLATFORM=linux/amd64
# Public API prefix used by the post-deploy smoke test.
# API_BASE=https://chores.dempseypalaciotascon.com/api
