# Copy to `.deploy.env` (gitignored) and fill in. Read by scripts/release.sh.
# Everything here is a path or a host alias — never put secrets in this file.

# ssh alias for the VPS (`ssh do` must work).
HOST=do

# --- Required: the release script refuses to run without these two ---
# Directory on the host that nginx serves the built frontend from.
WEB_ROOT=/var/www/chores
# Directory on the host holding docker-compose.yml (and the BE/ folder it bind-mounts).
COMPOSE_DIR=/opt/chores

# --- Optional ---
# Docker Hub repository, without a tag. The script pushes `<repo>:<git-sha>` and `<repo>:latest`.
# IMAGE=deejtsn/private:chores_api_v1

# Target platform. The dev machine is arm64 and the VPS is amd64 — do not change casually.
# PLATFORM=linux/amd64

# Public API prefix used by the post-deploy smoke test.
# API_BASE=https://chores.dempseypalaciotascon.com/api

# Live SQLite file, relative to the compose directory. Backed up before every release.
# REMOTE_DB=$COMPOSE_DIR/BE/data/database.db
